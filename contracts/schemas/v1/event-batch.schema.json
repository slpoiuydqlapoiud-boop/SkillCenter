{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-center.internal/schemas/v1/event-batch.schema.json",
  "title": "Skill Center Event Batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "schemaVersion", "events"],
  "properties": {
    "batchId": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "schemaVersion": {"const": "1.0"},
    "events": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"oneOf": [
      {"$ref": "invocation-event.schema.json"},
      {"$ref": "installation-event.schema.json"}
    ]}}
  }
}
