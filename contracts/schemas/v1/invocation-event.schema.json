{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-center.internal/schemas/v1/invocation-event.schema.json",
  "title": "Skill Invocation Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "occurredAt", "skillId", "version", "subject", "client", "sessionId", "status", "durationMs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "skillId": {"$ref": "#/$defs/slug"},
    "version": {"$ref": "#/$defs/semver"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "teamId"],
      "properties": {
        "userId": {"$ref": "#/$defs/principalId"},
        "teamId": {"$ref": "#/$defs/slug"}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": {"enum": ["codex", "department-agent", "skillmd-compatible", "gateway"]},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "sessionId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "status": {"enum": ["success", "failure", "cancelled", "timeout"]},
    "durationMs": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "errorCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "inputTokens", "outputTokens"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["failure", "timeout"]}}}, "then": {"required": ["errorCode"]}},
    {"if": {"properties": {"status": {"enum": ["success", "cancelled"]}}}, "then": {"not": {"required": ["errorCode"]}}}
  ],
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64},
    "principalId": {"type": "string", "pattern": "^[A-Za-z0-9._@-]{2,128}$"}
  }
}
