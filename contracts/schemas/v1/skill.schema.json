{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-center.internal/schemas/v1/skill.schema.json",
  "title": "Internal Skill Metadata V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "description", "ownerTeam", "maintainers", "category", "tags", "compatibility", "permissions", "dependencies", "language", "entry"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64},
    "name": {"type": "string", "minLength": 2, "maxLength": 100},
    "version": {"$ref": "#/$defs/semver"},
    "description": {"type": "string", "minLength": 10, "maxLength": 500},
    "ownerTeam": {"$ref": "#/$defs/slug"},
    "maintainers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/principalId"}},
    "category": {"$ref": "#/$defs/slug"},
    "tags": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client", "minimumVersion"],
        "properties": {
          "client": {"enum": ["codex", "department-agent", "skillmd-compatible"]},
          "minimumVersion": {"$ref": "#/$defs/semver"},
          "maximumVersion": {"$ref": "#/$defs/semver"}
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "network", "shell", "credentials", "mcpServers"],
      "properties": {
        "workspace": {"enum": ["none", "read", "write"]},
        "network": {"enum": ["none", "internal", "external"]},
        "shell": {"enum": ["none", "restricted", "unrestricted"]},
        "credentials": {"enum": ["none", "declared"]},
        "mcpServers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "version"],
        "properties": {
          "type": {"enum": ["runtime", "package", "mcp"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "source": {"type": "string", "maxLength": 256}
        }
      }
    },
    "language": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}},
    "entry": {"const": "SKILL.md"},
    "icon": {"type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$", "maxLength": 256},
    "releaseNotes": {"type": "string", "maxLength": 2000},
    "examples": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "output"],
        "properties": {"input": {"type": "string", "maxLength": 2000}, "output": {"type": "string", "maxLength": 4000}}
      }
    },
    "recommendedScenarios": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
    "unsupportedScenarios": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64},
    "principalId": {"type": "string", "pattern": "^[A-Za-z0-9._@-]{2,128}$"}
  }
}
