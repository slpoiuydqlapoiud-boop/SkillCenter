{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-center.internal/schemas/v1/install-manifest.schema.json",
  "title": "Skill Installation Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "skill", "artifact", "compatibility", "permissions", "dependencies", "issuedAt", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "manifestId": {"type": "string", "format": "uuid"},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "version": {"$ref": "#/$defs/semver"},
        "status": {"enum": ["published", "deprecated"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadUrl", "sha256", "sizeBytes", "mediaType"],
      "properties": {
        "downloadUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "mediaType": {"const": "application/zip"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "minimumVersion"],
      "properties": {
        "client": {"enum": ["codex", "department-agent", "skillmd-compatible"]},
        "minimumVersion": {"$ref": "#/$defs/semver"},
        "maximumVersion": {"$ref": "#/$defs/semver"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "network", "shell", "credentials", "mcpServers"],
      "properties": {
        "workspace": {"enum": ["none", "read", "write"]},
        "network": {"enum": ["none", "internal", "external"]},
        "shell": {"enum": ["none", "restricted", "unrestricted"]},
        "credentials": {"enum": ["none", "declared"]},
        "mcpServers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "issuedAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "expiresAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "deprecated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "replacementVersion": {"$ref": "#/$defs/semver"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"skill": {"properties": {"status": {"const": "deprecated"}}}}},
      "then": {"required": ["deprecated"]}
    }
  ],
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64}
  }
}
