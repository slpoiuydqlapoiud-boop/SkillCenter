# Local development only. Never use these values in a shared or production environment.
SKILL_CENTER_POSTGRES_DB=skillcenter
SKILL_CENTER_POSTGRES_USERNAME=skillcenter
SKILL_CENTER_POSTGRES_PASSWORD=local-dev-only
SKILL_CENTER_POSTGRES_PORT=5432

SKILL_CENTER_REDIS_PORT=6379

SKILL_CENTER_MINIO_ROOT_USER=skillcenter
SKILL_CENTER_MINIO_ROOT_PASSWORD=local-dev-only-change-me
SKILL_CENTER_MINIO_API_PORT=9000
SKILL_CENTER_MINIO_CONSOLE_PORT=9001

# Optional shared search acceptance profile; keep false for the default JSON-only local mode.
SKILL_CENTER_SEARCH_INDEX_BACKEND=json
SKILL_CENTER_SEARCH_INDEX_EVENTS_ENABLED=false
# Required when events are enabled; use one stable, unique value per API instance.
SKILL_CENTER_SEARCH_INDEX_EVENTS_CONSUMER_ID=workbuddy-api-1
# Optional acknowledged-event retention cleanup; requires V20 consumer lifecycle and fresh heartbeats.
SKILL_CENTER_SEARCH_INDEX_EVENTS_RETENTION_SCHEDULER_ENABLED=false
SKILL_CENTER_SEARCH_INDEX_EVENTS_RETENTION_DAYS=30
SKILL_CENTER_SEARCH_INDEX_EVENTS_RETENTION_CONSUMER_STALE_AFTER_MS=900000
SKILL_CENTER_SEARCH_INDEX_EVENTS_RETENTION_CLEANUP_INTERVAL_MS=3600000
SKILL_CENTER_SEARCH_INDEX_EVENTS_RETENTION_CLEANUP_INITIAL_DELAY_MS=3600000
SKILL_CENTER_SEARCH_INDEX_EVENTS_RETENTION_CLEANUP_BATCH_SIZE=1000
