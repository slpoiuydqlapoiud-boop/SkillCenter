# =============================================================================
# SkillCenter 生产环境配置模板
# =============================================================================
# 用法：
#   1. 复制本文件为目标环境命名（例：.env.prod.cluster-a）：
#        cp deploy/prod/.env.prod.template deploy/prod/.env.prod.cluster-a
#   2. 按各节注释替换占位值；所有 *_REF 与 *_CREDENTIAL_* 必须填入
#      Secret Manager 引用，格式 secret://<key-path>，禁止明文。
#   3. 部署前必须先跑过：
#        pwsh scripts/verify-production-config.ps1 -Json
#        pwsh scripts/verify-production-handoff.ps1 -BaseUrl https://<api> -Json
#      全部 READY 才能上线。
#   4. 本文件不进 git 跟踪（deploy/prod/.env.*），只跟踪 .env.prod.template。
# =============================================================================

# ----- 0. 部署标识 ---------------------------------------------------------------
# evidence: deployment
SKILL_CENTER_ENVIRONMENT=production
# 当前实例的稳定唯一 ID（多副本部署每实例不同），用于 search events consumer-id、
# runtime 日志关联、Prometheus instance label。
SKILL_CENTER_INSTANCE_ID=skillcenter-api-1

# ----- 1. 持久化（PostgreSQL） ----------------------------------------------------
# 所有持久化域必须切到 postgresql，禁止 json/local 默认值上生产。
# evidence: REDIS_HA / OBJECT_STORAGE / 数据库迁移
SKILL_CENTER_PERSISTENCE_BACKEND=postgresql
SKILL_CENTER_GOVERNANCE_BACKEND=postgresql
SKILL_CENTER_QUALITY_EVIDENCE_BACKEND=postgresql
SKILL_CENTER_BENCHMARK_BACKEND=postgresql
SKILL_CENTER_RELEASE_BACKEND=postgresql
SKILL_CENTER_OPTIMIZATION_WORK_ITEM_BACKEND=postgresql
SKILL_CENTER_OPTIMIZATION_EXPERIMENT_BACKEND=postgresql
SKILL_CENTER_PRODUCTION_EVIDENCE_BACKEND=postgresql
SKILL_CENTER_EXECUTION_ENVIRONMENT_BACKEND=postgresql
SKILL_CENTER_SKILL_SCOPE_BACKEND=postgresql
SKILL_CENTER_SKILL_RELATION_BACKEND=postgresql
SKILL_CENTER_LIFECYCLE_PROJECTION_BACKEND=postgresql

# PostgreSQL 连接：JDBC URL 不内嵌凭据
# example: jdbc:postgresql://pg-cluster.prod.svc:5432/skillcenter
SKILL_CENTER_POSTGRES_URL=jdbc:postgresql://CHANGE-ME.pg-cluster.prod.svc:5432/skillcenter
# 用户名/密码由编排层从 Secret Manager 解析后注入（不再走 _REF 后缀）
# Secret 路径：secret://skillcenter/prod/postgres/{username,password}
# K8s 推荐：ExternalSecret → secretKeyRef → env.valueFrom.secretKeyRef
SKILL_CENTER_POSTGRES_USERNAME=__INJECT_FROM_SECRET_MANAGER__
SKILL_CENTER_POSTGRES_PASSWORD=__INJECT_FROM_SECRET_MANAGER__

# 直接使用 Secret Manager 引用的替代写法（不被 ProductionConfigCheck 接受）：
# SKILL_CENTER_POSTGRES_USERNAME_REF=secret://...
# SKILL_CENTER_POSTGRES_PASSWORD_REF=secret://...
# ProductionConfigCheck 对 username/password 用的是 `kind=required`（仅非空校验），
# 不是 `kind=secret-ref`；DB 凭据的 Secret 解析约定由部署编排层负责，
# 见 deploy/prod/secret-references.md 第 2 节。

# ----- 2. 运行时状态（Redis HA） ---------------------------------------------------
# Redis 用于 runtime summary / alert state / operations metrics / 断点续传元数据 /
# 搜索刷新事件总线（Streams），必须 HA。
# evidence: REDIS_HA（接入指南 deploy/prod/redis-ha.md）
# ProductionConfigCheck 仅强制 backend=redis（3 项），Sentinel/Cluster 拓扑由本文件 + application-prod.yml 管理。
# 推荐生产拓扑：Redis Sentinel（3 sentinel + 1 master + 2 replica），运维更简单；
# 也可走 Cluster（必须用 hash tag 隔离 Streams key）。
SKILL_CENTER_RUNTIME_SUMMARY_BACKEND=redis
SKILL_CENTER_OPERATIONS_ALERT_STATE_BACKEND=redis
SKILL_CENTER_OPERATIONS_METRICS_STORAGE=redis
# Redis 拓扑模式（sentinel / cluster / standalone）；standalone 仅允许 loopback 测试
SKILL_CENTER_REDIS_MODE=sentinel
# Sentinel master 服务名（sentinel monitor <name> ... 配置项）
SKILL_CENTER_REDIS_SENTINEL_MASTER=skillcenter-redis-master
# Sentinel 节点列表（逗号分隔 host:port，建议 ≥3 个，分布在不同故障域）
SKILL_CENTER_REDIS_SENTINEL_NODES=sentinel-1.sentinel.prod.internal:26379,sentinel-2.sentinel.prod.internal:26379,sentinel-3.sentinel.prod.internal:26379
# Cluster 节点列表（仅 mode=cluster 时生效；用 hash tag 隔离 Streams key）
# SKILL_CENTER_REDIS_CLUSTER_NODES=cluster-1.cluster.prod.internal:6379,cluster-2.cluster.prod.internal:6379,cluster-3.cluster.prod.internal:6379
# 凭据统一走 Secret Manager；当前默认 Bean 解析 secret://env/<NAME>，生产推荐替换 Bean
SKILL_CENTER_REDIS_PASSWORD_REF=secret://env/SKILL_CENTER_REDIS_PASSWORD
# Cluster 模式额外需要的用户名（Redis 6+ ACL，sentinel 模式通常不需要）
# SKILL_CENTER_REDIS_USERNAME_REF=secret://env/SKILL_CENTER_REDIS_USERNAME
# TLS 开关（生产建议 true）
SKILL_CENTER_REDIS_TLS_ENABLED=true

# ----- 3. 告警调度与通知 ----------------------------------------------------------
# evidence: 告警渠道接通
SKILL_CENTER_OPERATIONS_ALERT_SCHEDULER_ENABLED=true
# 企业告警通知网关（HTTPS，无内嵌凭据）
SKILL_CENTER_OPERATIONS_ALERT_NOTIFICATION_URL=https://CHANGE-ME.alerts.prod.internal/ingest

# ----- 4. 对象存储（生产制品 / PIT 备份） -----------------------------------------
# evidence: OBJECT_STORAGE / BACKUP_PITR
SKILL_CENTER_ARTIFACT_STORAGE_BACKEND=object-storage
SKILL_CENTER_ARTIFACT_STORAGE_MODE=http
# 连接性探针（HEAD bucket，2s 超时，结果缓存 probe-ttl-seconds 秒）
SKILL_CENTER_ARTIFACT_STORAGE_PROBE_TTL_SECONDS=300
SKILL_CENTER_ARTIFACT_STORAGE_PROBE_SCHEDULER_ENABLED=true
SKILL_CENTER_ARTIFACT_STORAGE_PROBE_SCHEDULER_INTERVAL_MS=60000
SKILL_CENTER_ARTIFACT_STORAGE_PROBE_SCHEDULER_INITIAL_DELAY_MS=1000
# HTTPS endpoint，bucket 由租户配置；region 影响 SigV4 签名，不允许 default
SKILL_CENTER_ARTIFACT_STORAGE_ENDPOINT=https://CHANGE-ME.s3.prod.internal
SKILL_CENTER_ARTIFACT_STORAGE_BUCKET=skillcenter-prod
SKILL_CENTER_ARTIFACT_STORAGE_REGION=cn-north-1
# prefix 用于多租户隔离（仅 [A-Za-z0-9._/-]）；留空则按"sha256/<hash>.zip" 直接落到 bucket root
SKILL_CENTER_ARTIFACT_STORAGE_PREFIX=skill-packages
# 凭据必须走 Secret Manager；access-key-id 与 secret-access-key 独立 secret（避免合并复用）
SKILL_CENTER_ARTIFACT_STORAGE_ACCESS_KEY_ID_REF=secret://env/SKILL_CENTER_OBJECT_STORAGE_ACCESS_KEY_ID
SKILL_CENTER_ARTIFACT_STORAGE_SECRET_ACCESS_KEY_REF=secret://env/SKILL_CENTER_OBJECT_STORAGE_SECRET_ACCESS_KEY

# 公开下载/展示制品时使用的 HTTPS base URL（CDN 或签名 URL 前缀；非 SigV4 签名路径）
SKILL_CENTER_ARTIFACT_BASE_URL=https://CHANGE-ME.cdn.prod.example.com

# ----- 5. 制品上传与外部安全扫描 -------------------------------------------------
# evidence: PROVIDER_SECURITY（外部扫描服务）
# 适配契约见 deploy/prod/security-scanner.md。
# 关键约束：
#   - mode 必须 required；扫描不可用 → 上传拒绝（fail-closed）
#   - 四类能力必须齐全：MALWARE / SENSITIVE_INFORMATION / DEPENDENCY_VULNERABILITY / LICENSE
#   - endpoint 必须 HTTPS（loopback 测试例外）
#   - credential-ref 必须是 secret:// 格式；当前默认 Bean 解析 secret://env/<NAME>，
#     生产应替换 ProviderCredentialResolver Bean 为 Secret Manager 实现
SKILL_CENTER_PACKAGE_UPLOAD_BACKEND=distributed
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_MODE=required
# 四类能力必须齐全，缺一会被 verify-production-config 拒绝
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_CAPABILITIES=MALWARE,SENSITIVE_INFORMATION,DEPENDENCY_VULNERABILITY,LICENSE
# 安全扫描服务 HTTPS 端点（响应 schema：package-security-scan.v1）
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_ENDPOINT=https://CHANGE-ME.security-scanner.prod.internal
# 凭据引用：当前默认 Bean 只识别 secret://env/<ENV_VAR_NAME>
# 推荐：secret://env/SKILL_CENTER_SCANNER_TOKEN（并在容器环境注入该变量）
# 期望：secret://skillcenter/prod/security-scanner/token（需替换 ProviderCredentialResolver Bean）
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_CREDENTIAL_REF=secret://env/SKILL_CENTER_SCANNER_TOKEN
# 拉取连接超时（毫秒），合法范围 100-10000；建议 1500-3000
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_CONNECT_TIMEOUT_MS=2000
# 拉取请求超时（毫秒），合法范围 100-30000；扫描 50MB 包应放宽至 15000-30000
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_REQUEST_TIMEOUT_MS=30000
# 响应体上限（字节），合法范围 4096-4194304
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_MAX_RESPONSE_BYTES=1048576
# 请求体上限（字节），合法范围 4096-52428800；与 package-max-bytes 对齐
SKILL_CENTER_PACKAGE_SECURITY_EXTERNAL_MAX_REQUEST_BYTES=20971520

# ----- 6. Provider：OpenClaw / DeepEval / Langfuse -------------------------------
# evidence: OpenClaw / DeepEval / Langfuse 真实联调
# 全部 *_MODE=http 强制真实 HTTP 适配（不允许 contract-only fallback）
SKILL_CENTER_PROVIDERS_RUNNER=openclaw
SKILL_CENTER_PROVIDERS_EVALUATION=deepeval
SKILL_CENTER_PROVIDERS_OBSERVABILITY=langfuse
SKILL_CENTER_PROVIDERS_TRACE=langfuse

# 连接性探针（GET /healthz，2s 超时，结果缓存 probe-ttl-seconds 秒）
# 生产开启 scheduler，每分钟拉一次所有 Provider，结果在 /api/v1/admin/provider-probe 可查
SKILL_CENTER_PROVIDERS_PROBE_TTL_SECONDS=300
SKILL_CENTER_PROVIDERS_PROBE_SCHEDULER_ENABLED=true
SKILL_CENTER_PROVIDERS_PROBE_SCHEDULER_INTERVAL_MS=60000
SKILL_CENTER_PROVIDERS_PROBE_SCHEDULER_INITIAL_DELAY_MS=1000

# OpenClaw Agent Runtime（4 类请求 skillId/skillVersion/evaluationRunId/suiteId/caseId/timeoutMs/scenario/runtimeId/mcpServerId/llmProviderId）
# 请求超时使用 request.timeoutMs（默认 30s）；429 → RATE_LIMITED / 其他非 2xx → UPSTREAM_REJECTED / 解析失败 → UPSTREAM_INVALID_RESPONSE
SKILL_CENTER_OPENCLAW_MODE=http
SKILL_CENTER_OPENCLAW_ENDPOINT=https://CHANGE-ME.openclaw-runtime.prod.internal
# 默认 Bean：secret://env/<NAME> 直接读环境变量；要走真正 Secret Manager 请部署时替换 ProviderCredentialResolver Bean
SKILL_CENTER_OPENCLAW_CREDENTIAL_REF=secret://env/SKILL_CENTER_OPENCLAW_TOKEN

# DeepEval 评估（响应字段 passed/score/reason；score ∈ [0,100]，reason 无控制字符，adapter 内部超时 30s）
# 上游 429 → RATE_LIMITED / 5xx → TEMPORARY_UNAVAILABLE / 其他 4xx → UPSTREAM_REJECTED
SKILL_CENTER_DEEPEVAL_MODE=http
SKILL_CENTER_DEEPEVAL_ENDPOINT=https://CHANGE-ME.deepeval.prod.internal
SKILL_CENTER_DEEPEVAL_CREDENTIAL_REF=secret://env/SKILL_CENTER_DEEPEVAL_TOKEN

# Langfuse 观测（ObservabilityAdapter 用 endpoint，TraceProviderAdapter 用 trace-endpoint，adapter 内部超时 10s）
# 响应：observability 接受 {accepted: Boolean}（可空 body）；trace 必须 array 且 13 字段 allowlist（traceId/spanId/skillId/version/operation/status/durationMs/errorCode/dataSource/occurredAt/runtimeId/mcpServerId/llmProviderId）
SKILL_CENTER_LANGFUSE_MODE=http
SKILL_CENTER_LANGFUSE_ENDPOINT=https://CHANGE-ME.langfuse.prod.internal
SKILL_CENTER_LANGFUSE_TRACE_ENDPOINT=https://CHANGE-ME.langfuse.prod.internal/api/public/ingestion
SKILL_CENTER_LANGFUSE_CREDENTIAL_REF=secret://env/SKILL_CENTER_LANGFUSE_TOKEN

# ----- 7. 发布目标（受控上线） ----------------------------------------------------
# evidence: RELEASE_APPROVAL
SKILL_CENTER_RELEASE_TARGET_MODE=http
SKILL_CENTER_RELEASE_TARGET_ENDPOINT=https://CHANGE-ME.release-target.prod.internal
SKILL_CENTER_RELEASE_TARGET_CREDENTIAL_REF=secret://CHANGE-ME/release-target/token
# CONTROLLED：强制走上线审批；任何其他值都被拒绝
SKILL_CENTER_RELEASE_ADMISSION_MODE=CONTROLLED

# ----- 8. 搜索（OpenSearch HA） --------------------------------------------------
# evidence: 跨实例搜索刷新
SKILL_CENTER_SEARCH_INDEX_BACKEND=opensearch
SKILL_CENTER_SEARCH_INDEX_MODE=http
SKILL_CENTER_SEARCH_INDEX_ENDPOINT=https://CHANGE-ME.opensearch.prod.internal:9200
SKILL_CENTER_SEARCH_INDEX_NAME=skillcenter-skills-v1
# 必须开启跨实例事件，否则多副本搜索索引不一致
SKILL_CENTER_SEARCH_INDEX_EVENTS_ENABLED=true
# 每实例唯一 consumer-id（由 SKILL_CENTER_INSTANCE_ID 派生）
SKILL_CENTER_SEARCH_INDEX_EVENTS_CONSUMER_ID=skillcenter-api-1

# ----- 9. 企业身份（SSO / JWKS / JWT） -------------------------------------------
# evidence: SSO_ORGANIZATION（身份与组织目录）
# 适配契约见 deploy/prod/sso-integration.md 与
# docs/superpowers/specs/2026-08-25-jwks-actor-authentication-design.md。
# 关键约束：
#   - 只能配 jwks-uri 或 public-key 之一，两者都配或都为空 → 启动失败
#   - jwks-uri 必须 HTTPS（loopback 测试例外）
#   - JWKS 仅接受 kty=RSA / alg=RS256 / use=sig / 长度受限的 kid / RSA>=2048bit
#   - 任何校验失败统一映射为 Invalid bearer token，无明文回显
SKILL_CENTER_AUTHENTICATION_MODE=jwt
# JWKS 公钥发现端点（生产 HTTPS）；不允许内嵌密钥
SKILL_CENTER_JWT_JWKS_URI=https://CHANGE-ME.sso.prod.internal/.well-known/jwks.json
# 与 IdP 配置严格一致；issuer 不匹配 → 401
SKILL_CENTER_JWT_ISSUER=https://CHANGE-ME.sso.prod.internal/
# 受众标识，与 IdP 配置 audience claim 一致；aud 不匹配 → 401
SKILL_CENTER_JWT_AUDIENCE=skillcenter-api
# 团队 claim 名（按 IdP 实际下发字段调整，例 groups / custom_team）；最大 128 字符
SKILL_CENTER_JWT_TEAM_CLAIM=teams
# 团队 claim 是否必填；true 时缺 claim → 401（生产推荐 true，避免越权默认空集合）
SKILL_CENTER_JWT_TEAM_CLAIM_REQUIRED=true
# 时钟偏移容忍（秒），合法范围 0-300；生产建议 30-60
SKILL_CENTER_JWT_CLOCK_SKEW_SECONDS=60
# JWKS 拉取连接超时（毫秒），合法范围 100-10000
SKILL_CENTER_JWT_CONNECT_TIMEOUT_MS=1500
# JWKS 拉取请求超时（毫秒），合法范围 100-15000
SKILL_CENTER_JWT_REQUEST_TIMEOUT_MS=3000
# JWKS 缓存 TTL（秒），合法范围 1-86400；建议小于 IdP 密钥轮转间隔
SKILL_CENTER_JWT_CACHE_TTL_SECONDS=300
# JWKS 响应体上限（字节），合法范围 4096-1048576
SKILL_CENTER_JWT_MAX_RESPONSE_BYTES=262144

# ----- 10. 组织目录（同步快照） ---------------------------------------------------
# evidence: SSO_ORGANIZATION
# 适配契约见 deploy/prod/sso-integration.md 与
# docs/superpowers/specs/2026-08-25-organization-directory-snapshot-design.md。
# 关键约束：
#   - endpoint 必须 HTTPS（loopback 例外）；credential 必须走 Secret Manager
#   - 响应 schemaVersion 必须为 organization-directory.v1
#   - 顶层字段 allowlist：schemaVersion / source / revision / fetchedAt / teams
#   - team 字段 allowlist：teamId / name / status / memberUserIds
#   - 任何未知字段/响应非法/网络不可用 → DIRECTORY_INVALID_RESPONSE 等 fail-closed
SKILL_CENTER_ORGANIZATION_DIRECTORY_MODE=http
SKILL_CENTER_ORGANIZATION_DIRECTORY_ENDPOINT=https://CHANGE-ME.org-directory.prod.internal
# Bearer token 走 Secret Manager；Org Directory 通过 secret:// 解析后作为 Bearer 注入
SKILL_CENTER_ORGANIZATION_DIRECTORY_CREDENTIAL_REF=secret://CHANGE-ME/org-directory/token
# 拉取连接超时（毫秒），合法范围 100-10000
SKILL_CENTER_ORGANIZATION_DIRECTORY_CONNECT_TIMEOUT_MS=1500
# 拉取请求超时（毫秒），合法范围 100-15000
SKILL_CENTER_ORGANIZATION_DIRECTORY_REQUEST_TIMEOUT_MS=3000
# 响应体上限（字节），合法范围 4096-1048576
SKILL_CENTER_ORGANIZATION_DIRECTORY_MAX_RESPONSE_BYTES=1048576
# 快照最大保鲜期（秒），合法范围 30-86400；超期视为 DIRECTORY_STALE
SKILL_CENTER_ORGANIZATION_DIRECTORY_MAX_AGE_SECONDS=900

# ----- 11. 网络出口与白名单（运行期由底层平台注入，本文件不存） -----------------
# 仅记录在 README：所有 *_ENDPOINT 必须落在企业网络白名单内，Secret Manager 负责
# 凭据注入；TLS 证书由平台 cert-manager 管理，不在本文件出现。

# ----- 12. 备份 / PITR / 灾备 ----------------------------------------------------
# 见 README "备份与灾备" 节。PostgreSQL PITR 由云 RDS / 自建 WAL-G 注入；
# 对象存储跨区复制由 storage 平台配置；凭据均走 Secret Manager。